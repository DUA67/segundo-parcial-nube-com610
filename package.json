{
  "name": "api-libros-cloud",
  "version": "1.0.0",
  "description": "API REST para gestion de libros con Node.js, Express, MySQL RDS y CI/CD en GitHub Actions",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "test": "jest --runInBand --detectOpenHandles"
  },
  "keywords": [
    "express",
    "mysql",
    "aws",
    "rds",
    "ec2",
    "docker",
    "github-actions"
  ],
  "author": "Daniel Ugarte",
  "license": "MIT",
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "mysql2": "^3.12.0"
  },
  "devDependencies": {
    "jest": "^29.7.0",
    "supertest": "^7.0.0"
  },
  "jest": {
    "testEnvironment": "node",
    "verbose": true,
    "testMatch": [
      "**/tests/**/*.test.js"
    ],
    "setupFilesAfterEnv": [
      "<rootDir>/tests/setup.js"
    ]
  }
}
